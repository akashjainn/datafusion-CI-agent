##[start-action display=Run bail() {;id=__taiki-e_install-action.__run]
##[group]Run bail() {
^[[36;1mbail() {^[[0m
^[[36;1m  printf '::error::install-action: %s\n' "$*"^[[0m
^[[36;1m  exit 1^[[0m
^[[36;1m}^[[0m
^[[36;1m# If /bin/sh is dash, environment variable containing % is not imported, but is fine^[[0m
^[[36;1m# because it also means that it will not be exposed to subprocess.^[[0m
^[[36;1mif /usr/bin/env | grep -Eq '^BASH_FUNC_'; then^[[0m
^[[36;1m  bail 'bash function injection via BASH_FUNC_ environment variable is not allowed for security reasons'^[[0m
^[[36;1mfi^[[0m
^[[36;1mif ! command -v bash >/dev/null; then^[[0m
^[[36;1m  if grep -Eq '^ID=alpine' /etc/os-release; then^[[0m
^[[36;1m    printf '::group::Install packages required for install-action (bash)\n'^[[0m
^[[36;1m    # NB: sync with apk_install in main.sh^[[0m
^[[36;1m    if command -v sudo >/dev/null; then^[[0m
^[[36;1m      sudo apk --no-cache add bash^[[0m
^[[36;1m    elif command -v doas >/dev/null; then^[[0m
^[[36;1m      doas apk --no-cache add bash^[[0m
^[[36;1m    else^[[0m
^[[36;1m      apk --no-cache add bash^[[0m
^[[36;1m    fi^[[0m
^[[36;1m    printf '::endgroup::\n'^[[0m
^[[36;1m  else^[[0m
^[[36;1m    bail 'this action requires bash'^[[0m
^[[36;1m  fi^[[0m
^[[36;1mfi^[[0m
^[[36;1mbash --noprofile --norc "${GITHUB_ACTION_PATH:?}/main.sh"^[[0m
