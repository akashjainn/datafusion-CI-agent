^[[36;1m# Work around intermittent "[16] Error in the HTTP2 framing layer"^[[0m
^[[36;1m# failures from curl when cargo fetches crates from crates.io.^[[0m
^[[36;1m# Disabling HTTP/2 multiplexing forces cargo to serialize requests,^[[0m
^[[36;1m# and raising retries makes transient network hiccups self-heal.^[[0m
^[[36;1m#^[[0m
^[[36;1m# Reference:^[[0m
^[[36;1m# https://doc.rust-lang.org/cargo/reference/config.html?#httpmultiplexing^[[0m
^[[36;1m# https://doc.rust-lang.org/cargo/reference/config.html?#netretry^[[0m
^[[36;1mecho "CARGO_HTTP_MULTIPLEXING=false" >> $GITHUB_ENV^[[0m
^[[36;1mecho "CARGO_NET_RETRY=10" >> $GITHUB_ENV^[[0m
^[[36;1mecho "CARGO_HTTP_RETRY=10" >> $GITHUB_ENV^[[0m
